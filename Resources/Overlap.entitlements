<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Distributed outside the App Store (Developer ID), unsandboxed so the
	     app can read/write Finder tags across the user's folders. Hardened
	     runtime is enabled at signing time; no exception entitlements needed. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
